# Every key is optional: anything left blank falls back (see /health).

# Neon Postgres. Blank = JSON seed data + in-memory plans (lost on restart).
DATABASE_URL=

# Claude: ranks suggestions; also used by scripts/generate_cases.py
ANTHROPIC_API_KEY=

# Databricks SQL warehouse (Connection details tab). Blank = suggestions come from templates.
DATABRICKS_HOST=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
# Unity Catalog name (Free Edition's default is usually "workspace"); blank = no catalog prefix
DATABRICKS_CATALOG=
DATABRICKS_SCHEMA=isthmus

# Resend email. Without a verified domain, only the Resend account owner's address receives mail.
RESEND_API_KEY=
EMAIL_FROM=Isthmus Care <onboarding@resend.dev>

# Frontend URL, used in share links and emails
PUBLIC_APP_URL=http://localhost:3000
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
